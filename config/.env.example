# Copy to config/.env and fill in. Never commit config/.env.

# Required — analysis stage
ANTHROPIC_API_KEY=sk-ant-...

# TikTok — only after your app's Content Posting API scope is approved.
# Unapproved apps can post to drafts/SELF_ONLY only.
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Instagram Reels — needs a Business/Creator account linked to a Facebook Page,
# plus a public HTTPS host for the media file (the Graph API will not accept a
# direct upload).
# IG_ACCESS_TOKEN=
# IG_USER_ID=

# YouTube uses OAuth, not env vars:
#   1. Google Cloud Console -> enable YouTube Data API v3
#   2. Create an OAuth client of type "Desktop app"
#   3. Save the JSON as config/youtube_client_secret.json
#   4. Run: boyd auth youtube
